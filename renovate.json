{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Automerge GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
